# Server. Copy to .env or .env.local and do not commit it.
# The server reads both. A value already in the process environment wins.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
REALM_CONTRACT=realm.example.testnet
RELAYER_ACCOUNT=relayer.example.testnet
RELAYER_KEYS=ed25519:REPLACE_ME
DEALER_ACCOUNT=boss.example.testnet
DEALER_KEYS=ed25519:REPLACE_ME
DEALER_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_URL=postgres://user:pass@localhost:5432/cnc
CLIENT_ORIGIN=http://localhost:5173
PORT=8787
# ANTHROPIC_API_KEY=          # optional. The owner agent speaks without it.
# RELAY_DISABLED=1            # kill switch: reject every relay
# ACCOUNT_CREATE_YOCTO=50000000000000000000000
# FAUCET_YOCTO=5000000000000000000000000

# Client (Vite). Default stays on the offline mock.
# VITE_BACKEND=chain
# VITE_API_URL=http://localhost:8787
# VITE_REALM_CONTRACT=realm.example.testnet
# VITE_NEAR_RPC=https://rpc.testnet.near.org
